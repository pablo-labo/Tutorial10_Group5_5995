<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:tag="layout/activity_debug_flags_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <EditText
        android:id="@+id/debugFlagsFilterEditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Search flag names"
        android:layout_weight="0"
        android:inputType="text"
        android:importantForAutofill="no"/>
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/debugFlagsComposeView"
        android:padding="8dp"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        style="?attr/buttonBarStyle">
        <Button
            android:id="@+id/debugFlagsCloseButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Close without saving"
            android:layout_weight="1"
            style="?attr/buttonBarButtonStyle"/>
        <Button
            android:id="@+id/debugFlagsSaveButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Save"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            style="?attr/buttonBarButtonStyle"/>
    </LinearLayout>
</LinearLayout>
