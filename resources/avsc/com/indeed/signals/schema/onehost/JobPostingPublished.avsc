    "type" : "string"
  }, {
    "name" : "clientPublishTimestamp",
    "type" : "long"
  }, {
    "name" : "hasHostedJobs",
    "type" : "boolean"
  }, {
    "name" : "isFirstJob",
    "type" : "boolean"
  }, {
    "name" : "eventSource",
    "type" : {
      "type" : "enum",
      "name" : "EventSource",
      "symbols" : [ "FAR", "LEGACY" ]
    }
  }, {
    "name" : "jobposting_session_id",
    "type" : "string"
  }, {
    "name" : "advertiserNumber",
    "type" : "string"
  }, {
    "name" : "advertiserKey",
    "type" : "string"
  }, {
    "name" : "ctk",
    "type" : "string"
  }, {
    "name" : "publishedId",
    "type" : [ "null", "string" ],
    "default" : null
  }, {
    "name" : "occupationUuid",
    "type" : [ "null", "string" ],
    "default" : null
  }, {
    "name" : "jobCountry",
    "type" : [ "null", "string" ],
    "default" : null
  }, {
    "name" : "jobLanguage",
    "type" : [ "null", "string" ],
    "default" : null
  }, {
