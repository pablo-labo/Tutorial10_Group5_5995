      "symbols" : [ "NO_MEASUREMENT", "UNDER_5_MINUTES", "OVER_5_MINUTES" ],
      "default" : "NO_MEASUREMENT"
    } ],
    "default" : null
  }, {
    "name" : "totalFunnelTimingMs",
    "type" : [ "null", "long" ],
    "default" : null
  } ],
  "unstable_metrics" : [ {
    "name" : "signals.onehost.jobposting.published",
    "tags" : [ "isFirstJob", "funnelTiming" ]
