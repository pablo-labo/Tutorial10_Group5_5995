{
  "type" : "record",
  "name" : "ReferralParams",
  "namespace" : "com.indeed.signals.schema.jsma.evergreen",
  "fields" : [ {
    "name" : "affiliateKey",
    "type" : [ "string", "null" ],
    "doc" : "The affiliate key for the referral. (AFF in the cookie) This maps to the SID parameter in the log entries."
  }, {
    "name" : "keywords",
    "type" : [ "string", "null" ],
    "doc" : "The keywords used for attribution. (KW in the cookie)"
  }, {
    "name" : "newCookieValue",
    "type" : [ "string", "null" ],
    "doc" : "The encrypted value for the RF cookie. Mobile applications should put this value in the RF cookie\nin the device's cookie store. Note that may change from what was set in the input."
  }, {
    "name" : "referrer",
    "type" : [ "string", "null" ],
    "doc" : "The referrer URL for REF types."
  }, {
    "name" : "host",
    "type" : [ "string", "null" ],
    "doc" : "The host of the \"page\" of the request for referrals. For native apps, you should pass\nin the hostname of the Home Page url."
  }, {
    "name" : "refType",
    "type" : [ "string", "null" ],
    "doc" : "The calculated type of the referral."
  }, {
    "name" : "refTime",
    "type" : [ "string", "null" ],
    "doc" : "Timestamp of this referral calculation."
  }, {
    "name" : "reqAffiliateKey",
    "type" : [ "string", "null" ],
    "doc" : "If there was an existing cookie, the original affiliate key. (AFF)"
  }, {
    "name" : "reqKeywords",
    "type" : [ "string", "null" ],
    "doc" : "If there were existing cookie, the original keywords. (KW)"
  }, {
    "name" : "reqRefType",
    "type" : [ "string", "null" ],
    "doc" : "If there was an existing cookie, the original refType."
  }, {
    "name" : "from",
    "type" : [ "string", "null" ]
  }, {
    "name" : "fbclid",
    "type" : [ "string", "null" ]
  }, {
    "name" : "gclid",
    "type" : [ "string", "null" ]
  }, {
    "name" : "utm_properties",
    "type" : [ "null", {
      "type" : "map",
      "values" : {
        "type" : "record",
        "name" : "JsmaDynamicProperty",
        "fields" : [ {
          "name" : "property",
          "type" : [ "null", "string", "long" ]
        } ]
      }
    } ],
    "default" : null
  } ]
}