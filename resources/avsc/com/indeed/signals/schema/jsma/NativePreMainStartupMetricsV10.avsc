      "symbols" : [ "COLD", "WARM", "HOT" ]
    }
  }, {
    "name" : "timeStampBegin",
    "type" : {
      "type" : "long",
      "logicalType" : "timestamp-millis"
    }
  }, {
    "name" : "timeStampEnd",
    "type" : {
      "type" : "long",
      "logicalType" : "timestamp-millis"
    }
  } ],
  "logEntryType" : "jsmaPreMainStartupMetrics"
