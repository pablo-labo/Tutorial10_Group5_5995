{
  "type" : "record",
  "name" : "NativeScreenV3",
  "namespace" : "com.indeed.signals.schema.jsma",
  "fields" : [ {
    "name" : "device",
    "type" : {
      "type" : "record",
      "name" : "NativeDeviceV3",
      "fields" : [ {
        "name" : "platform",
        "type" : {
          "type" : "enum",
          "name" : "PlatformsV3",
          "symbols" : [ "IOS", "ANDROID" ]
        }
      }, {
        "name" : "manufacturer",
        "type" : [ "null", "string" ],
        "default" : null
      }, {
        "name" : "model",
        "type" : [ "null", "string" ],
        "default" : null
      } ]
    }
  }, {
    "name" : "properties",
    "type" : {
      "type" : "record",
      "name" : "NativeEventPropertiesV3",
      "fields" : [ {
        "name" : "appId",
        "type" : {
          "type" : "enum",
          "name" : "NativeAppIdsV3",
          "symbols" : [ "JOB_SEARCH_ANDROID", "JOB_SEARCH_IOS" ]
        }
      }, {
        "name" : "appVersion",
        "type" : "string"
      }, {
        "name" : "appBuildNum",
        "type" : "int"
      }, {
        "name" : "appVariant",
        "type" : "string"
      }, {
        "name" : "appEnvironment",
        "type" : "string"
      }, {
        "name" : "osVersion",
        "type" : [ "null", "string" ],
        "default" : null
      }, {
        "name" : "clientEventId",
        "type" : "string"
      }, {
        "name" : "appInstallId",
        "type" : "string"
      }, {
        "name" : "appSessionId",
        "type" : "string"
      }, {
        "name" : "sessionId",
        "type" : "string"
      }, {
        "name" : "clientCreatedTimestamp",
        "type" : {
          "type" : "long",
          "logicalType" : "timestamp-millis"
        }
      }, {
        "name" : "groups",
        "type" : {
          "type" : "array",
          "items" : "string"
        }
      }, {
        "name" : "ctk",
        "type" : [ "null", "string" ],
        "default" : null
      }, {
        "name" : "deviceId",
        "type" : [ "null", "string" ],
        "default" : null
      }, {
        "name" : "userLocale",
        "type" : [ "null", "string" ],
        "default" : null
      }, {
        "name" : "deviceOrientation",
        "type" : {
          "type" : "enum",
          "name" : "DeviceOrientationsV3",
          "symbols" : [ "LANDSCAPE", "PORTRAIT" ]
        }
      } ]
    }
  }, {
    "name" : "screenName",
    "type" : "string"
  } ],
  "logEntryType" : "jsmaNativeScreen"
}