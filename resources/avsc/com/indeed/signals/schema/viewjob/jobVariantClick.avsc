{
  "type" : "record",
  "name" : "jobVariantClick",
  "namespace" : "com.indeed.signals.schema.viewjob",
  "fields" : [ {
    "name" : "mobtk",
    "type" : [ "null", "string" ],
    "doc" : "The mobile tracking key, i.e. the mobtk, such as 1hsuhpfqs0000001",
    "default" : null
  }, {
    "name" : "mobvjtk",
    "type" : [ "null", "string" ],
    "doc" : "The mobile view job tracking key for connecting to main mobviewjob log",
    "default" : null
  }, {
    "name" : "jobKey",
    "type" : [ "null", "string" ],
    "doc" : "The job key (jk) of the job currently opened in VJ where the user clicked a variant",
    "default" : null
  }, {
    "name" : "jobVariantJobKey",
    "type" : [ "null", "string" ],
    "doc" : "Job variant identifier that was clicked (bfcache can have multiple)",
    "default" : null
  } ],
  "logEntryType" : "jobVariantClick"
}